# When set, the per-restaurant registry persists to MongoDB instead of the local
# REGISTRY_STORE JSON file below -- survives restarts AND works across more than one
# instance of this service. Can reuse RestoMindAPI's own connection string.
MONGO_URL=

# Only used when MONGO_URL is unset.
REGISTRY_STORE=data/registry.json
AI_SHARED_SECRET=
CORS_ORIGINS=http://localhost:3000

# Free-tier OpenAI-compatible LLM -- used by both the Arabic offer-copy generator
# (app/marketing/copy.py) and the market research agent (app/agents/market_research.py).
# Leave LLM_API_KEY blank to fall back to templates / an "unavailable" research result.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Market research agent (plan.md Part C). Needs BOTH this and LLM_API_KEY -- searching
# without an LLM to synthesise leaves raw results with no multiplier, and synthesising
# without real search results is the same ungrounded guess this replaces. Free tier at
# tavily.com, capped monthly -- fine for periodic per-restaurant research, not a loop.
TAVILY_API_KEY=
