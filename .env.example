# Per-restaurant registry persistence. Two mutually exclusive options:
#
#   MONGO_URL set      -> durable, production path. One document per restaurant;
#                          survives a crash or redeploy. REGISTRY_STORE is ignored.
#   MONGO_URL unset     -> falls back to REGISTRY_STORE below (a single JSON file,
#                          for local dev without a MongoDB running).
#
# MONGO_URL=mongodb://127.0.0.1:27017
# MONGO_DB=restomind_ai
REGISTRY_STORE=data/registry.json
# API key auth (docs/01-api-key-hardening.md). Leave both unset for local dev -- auth is
# skipped entirely. In any deployed environment, set REQUIRE_API_KEY=true and API_KEY_HASH
# to the SHA-256 hex digest of the real key (never the raw key itself -- see docs §2.2/§3.2).
REQUIRE_API_KEY=false
API_KEY_HASH=
# No CORS_ORIGINS: this service is never called from a browser directly, only the
# backend calls it server-to-server, so CORSMiddleware was removed rather than
# configured (docs/03-cors-and-rate-limiting.md §2.1).
#
# Cost-guard rate limiting (docs/03 §2.2) -- always on, not a real per-user limiter,
# just a ceiling against a malfunctioning/compromised caller running up the bill. Leave
# these unset (or blank, as below) to use the safe hardcoded fallback shown in each
# comment; only override per-deploy if real traffic shows the defaults are wrong.
RATE_LIMIT_DEFAULT_PER_MIN=      # fallback 300 -- cheap routes (forecast/surplus/restomind)
RATE_LIMIT_MARKETING_PER_MIN=    # fallback 20  -- /marketing/generate-offer, /marketing/publish
RATE_LIMIT_WINDOW_SECONDS=       # fallback 60
