# Per-restaurant registry persistence. Two mutually exclusive options:
#
#   MONGO_URL set      -> durable, production path. One document per restaurant;
#                          survives a crash or redeploy. REGISTRY_STORE is ignored.
#   MONGO_URL unset     -> falls back to REGISTRY_STORE below (a single JSON file,
#                          for local dev without a MongoDB running).
#
# MONGO_URL=mongodb://127.0.0.1:27017
# MONGO_DB=restomind_ai
REGISTRY_STORE=data/registry.json

AI_SHARED_SECRET=
CORS_ORIGINS=http://localhost:3000
